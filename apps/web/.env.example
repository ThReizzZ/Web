# Copy to .env.local for local development without Docker.
# These values are for development only and contain no secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Empty means "same origin"; Next.js proxies /api/v1 via the rewrite below.
NEXT_PUBLIC_API_BASE_URL=
API_INTERNAL_URL=http://127.0.0.1:8080
