# Copy to .env for running the API without Docker.
# The password must match your local PostgreSQL instance. Do not commit .env.

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
DATABASE_URL=postgres://threi:change-me-in-production@127.0.0.1:5432/threi
DATABASE_MAX_CONNECTIONS=5
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECS=5
DATABASE_CONNECT_TIMEOUT_SECS=5
REDIS_URL=redis://:change-me-in-production@127.0.0.1:6379/0
REDIS_REQUIRED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000
STEAM_RETURN_URL=http://localhost:3000/api/v1/auth/steam/callback
STEAM_REALM=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Comma-separated SteamID64 values used to bootstrap admin accounts.
# Existing database roles are managed from the admin panel after first login.
ADMIN_STEAM_IDS=
API_DOCS_ENABLED=true
RUST_LOG=threi_api=debug,tower_http=debug

# Game server status is not polled by the API. Install the ThRei_Players
# SourceMod plugin and generate a per-server token in the admin panel.
# See plugins/ThRei_Players/README.md.
