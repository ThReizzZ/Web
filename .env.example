# ---------------------------------------------------------------------------
# threi — Docker Compose environment template
#
# Copy this file to `.env` and replace every `change-me` value before using
# the stack outside a local machine. `.env` is ignored by Git.
#
# IMPORTANT: This file must never contain real credentials.
# Passwords that appear inside `DATABASE_URL` (and inside the Redis URL
# assembled by Compose) must be URL-safe or percent-encoded.
# ---------------------------------------------------------------------------

# Deployment ---------------------------------------------------------------
# Public origin used by the web app for canonical URLs, sitemap entries, and
# the Steam OpenID return URL. HTTPS is required for a public deployment.
SITE_URL=http://localhost
# Host/port binding for the Nginx entry point. Only Nginx is published.
# Default is loopback-only. Set 0.0.0.0 only behind a firewall / security group.
HTTP_BIND=127.0.0.1
HTTP_PORT=80
# Nginx server_name; use your real domain in production, `_` for local use.
SERVER_NAME=_

# Image tag used for the locally built web/api images.
IMAGE_TAG=0.1.0

# PostgreSQL ---------------------------------------------------------------
# `postgres` is the Compose service hostname. Do not change it unless you
# also change compose.yaml.
POSTGRES_DB=threi
POSTGRES_USER=threi
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgres://threi:change-me-in-production@postgres:5432/threi
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECS=5
DATABASE_CONNECT_TIMEOUT_SECS=5

# Redis --------------------------------------------------------------------
# Redis is used for cache / transient state only (see docs/ARCHITECTURE.md).
REDIS_PASSWORD=change-me-in-production
REDIS_REQUIRED=true
REDIS_MAXMEMORY=256mb

# Steam authentication -----------------------------------------------------
# Steam OpenID is the only login method. Compose derives WEB_URL,
# STEAM_RETURN_URL and STEAM_REALM from SITE_URL above.
# Set to true when the public origin uses HTTPS. For local HTTP only, set false.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Comma-separated SteamID64 values used to bootstrap admin accounts.
# Existing database roles are managed from the admin panel after first login.
# Example: 76561198000000000,76561198000000001
ADMIN_STEAM_IDS=

# Server-side Steam Community base URL used for OpenID check_authentication and
# profile XML lookups. Point this at a relay (for example
# https://steam.threi.online) when the API host cannot reach
# steamcommunity.com. The browser login redirect still goes directly to Steam.
STEAM_COMMUNITY_BASE_URL=https://steamcommunity.com

# Development-only escape hatch for networks that cannot reach
# steamcommunity.com. When true, the server accepts the Steam assertion without
# calling OpenID check_authentication and uses a local fallback nickname/avatar.
# The API refuses to start with this enabled unless APP_ENV=development.
# Never enable this in production.
STEAM_SKIP_OPENID_VERIFICATION=false

# Game server reporting ----------------------------------------------------
# Live status and player rosters are reported by the ThRei_Players SourceMod
# plugin, not polled by the API. Generate a per-server token in the admin panel
# and install the plugin from plugins/ThRei_Players/. No API environment
# variables are required. See plugins/ThRei_Players/README.md.

# API ----------------------------------------------------------------------
APP_ENV=production
API_DOCS_ENABLED=false
# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty in production when Nginx serves web and API on one origin.
CORS_ALLOWED_ORIGINS=
REQUEST_TIMEOUT_SECS=30
REQUEST_BODY_LIMIT_BYTES=1048576
# JSON logs are recommended for container log collection.
LOG_JSON=true
RUST_LOG=info

# Web ----------------------------------------------------------------------
# Browser-facing API base URL baked into the Next.js build.
# Empty means "same origin" (recommended behind Nginx).
NEXT_PUBLIC_API_BASE_URL=
